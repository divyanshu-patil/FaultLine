{
  "name": "faultline",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint --max-warnings 0 . && pnpm --filter web lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter web check-types",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && sh scripts/check-no-prod-host.sh",
    "db:migrate": "node --env-file-if-exists=.env packages/db/src/migrate-cli.ts",
    "setup:webhook": "node --env-file-if-exists=.env scripts/setup-webhook.ts",
    "eval:bugs": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/eval-bugs.ts",
    "eval:agent": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/eval-agent.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed.ts",
    "test:api": "cd apps/api && .venv/bin/python -m pytest -q"
  },
  "devDependencies": {
    "@faultline/core": "workspace:*",
    "@faultline/db": "workspace:*",
    "@faultline/eslint-config": "workspace:*",
    "@faultline/patch": "workspace:*",
    "@faultline/paypal": "workspace:*",
    "@faultline/schemas": "workspace:*",
    "@faultline/testing": "workspace:*",
    "@faultline/trace": "workspace:*",
    "@faultline/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
