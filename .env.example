# FaultLine environment (names only — never commit real secrets; .env is git-ignored)

# --- PayPal (SANDBOX ONLY). FaultLine refuses any non-sandbox host at boot. ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_HOST=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Sandbox buyer used for assisted/live checkout approval (optional for offline eval)
SANDBOX_BUYER_EMAIL=
# Needed only for fully-automated live purchases (see docs/18); otherwise use assisted/fake approval
SANDBOX_BUYER_PASSWORD=

# --- Ollama Cloud (Gemma 4 31B) ---
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com

# --- Database (local Postgres or Supabase session pooler :5432, not the :6543 txn pooler) ---
DATABASE_URL=postgres://localhost:5432/faultline

# --- API (apps/api, FastAPI) ---
PORT=4000
SESSION_SECRET=change-me-min-16-chars
ACCESS_CODES=demo
OPERATOR_CODES=
FAULTLINE_MODE=hosted           # hosted | selfhost
ALLOW_EXTERNAL_TARGETS=false
COOKIE_SECURE=false             # true behind HTTPS

# --- Web (apps/web) ---
API_ORIGIN=http://localhost:4000

# --- BuggyBeans victim store / worker ---
PROBE_TOKEN=change-me-min-16-chars
